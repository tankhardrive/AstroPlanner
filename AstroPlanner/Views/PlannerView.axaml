<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AstroPlanner.ViewModels"
             x:Class="AstroPlanner.Views.PlannerView"
             x:DataType="vm:PlannerViewModel">

    <DockPanel>

        <!-- ── Filter bar ── -->
        <Border DockPanel.Dock="Top"
                Padding="10,8"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
            <StackPanel Orientation="Vertical" Spacing="6">

                <!-- Row 1: Search · Catalog · Type -->
                <StackPanel Orientation="Horizontal" Spacing="14">

                    <TextBox Width="190"
                             PlaceholderText="Search name, M31, NGC…"
                             Text="{Binding SearchText}"
                             VerticalAlignment="Center"/>

                    <!-- Catalog -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Catalog:" FontSize="11" Opacity="0.55" VerticalAlignment="Center" Margin="0,0,2,0"/>
                        <ToggleButton Content="Messier"  IsChecked="{Binding ShowMessier}"  Padding="8,3" FontSize="11"/>
                        <ToggleButton Content="Caldwell" IsChecked="{Binding ShowCaldwell}" Padding="8,3" FontSize="11"/>
                        <ToggleButton Content="NGC"      IsChecked="{Binding ShowNgc}"      Padding="8,3" FontSize="11"/>
                        <ToggleButton Content="IC"       IsChecked="{Binding ShowIc}"       Padding="8,3" FontSize="11"/>
                    </StackPanel>

                    <!-- Type -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Type:" FontSize="11" Opacity="0.55" VerticalAlignment="Center" Margin="0,0,2,0"/>
                        <ToggleButton Content="Galaxies" IsChecked="{Binding ShowGalaxies}" Padding="8,3" FontSize="11"/>
                        <ToggleButton Content="Clusters" IsChecked="{Binding ShowClusters}" Padding="8,3" FontSize="11"/>
                        <ToggleButton Content="Nebulae"  IsChecked="{Binding ShowNebulae}"  Padding="8,3" FontSize="11"/>
                        <ToggleButton Content="Planets"  IsChecked="{Binding ShowPlanets}"  Padding="8,3" FontSize="11"/>
                        <ToggleButton Content="Stars"    IsChecked="{Binding ShowStars}"    Padding="8,3" FontSize="11"/>
                        <ToggleButton Content="Comets"   IsChecked="{Binding ShowComets}"   Padding="8,3" FontSize="11"/>
                    </StackPanel>

                </StackPanel>

                <!-- Row 2: Constellation · Mag · Min vis · Visible only · Clear -->
                <StackPanel Orientation="Horizontal" Spacing="14">

                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Constellation:" FontSize="11" Opacity="0.55" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding Constellations}"
                                  SelectedItem="{Binding SelectedConstellation}"
                                  Width="110" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Mag ≤" FontSize="11" Opacity="0.55" VerticalAlignment="Center"/>
                        <NumericUpDown Value="{Binding MaxMagnitude}"
                                       Minimum="1" Maximum="20" Increment="0.5"
                                       FormatString="F1" Width="115"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Min vis." FontSize="11" Opacity="0.55" VerticalAlignment="Center"/>
                        <NumericUpDown Value="{Binding MinDurationHours}"
                                       Minimum="0" Maximum="12" Increment="0.5"
                                       FormatString="F1" Width="115"/>
                        <TextBlock Text="h" FontSize="11" Opacity="0.55" VerticalAlignment="Center"/>
                    </StackPanel>

                    <CheckBox Content="Visible only"
                              IsChecked="{Binding OnlyVisible}"
                              VerticalAlignment="Center"/>

                    <Button Content="✕ Clear"
                            Command="{Binding ClearFiltersCommand}"
                            IsVisible="{Binding HasActiveFilters}"
                            VerticalAlignment="Center"/>

                </StackPanel>

            </StackPanel>
        </Border>

        <!-- ── Status bar ── -->
        <Border DockPanel.Dock="Bottom"
                Padding="8,3"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
            <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.7"/>
        </Border>

        <!-- ── DataGrid ── -->
        <DataGrid ItemsSource="{Binding DisplayRows}"
                  SelectedItem="{Binding SelectedRow}"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="True"
                  CanUserResizeColumns="True"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  Sorting="OnGridSorting"
                  DoubleTapped="OnGridDoubleTapped"
                  x:Name="ObjectGrid">

            <DataGrid.Columns>

                <DataGridTextColumn Binding="{Binding PrimaryName}"
                                    Width="225" SortMemberPath="PrimaryName">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Name"
                                   ToolTip.Tip="Primary name — common name if available, then Messier number, then catalog ID"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn Binding="{Binding CatalogIds}"
                                    Width="155" SortMemberPath="CatalogIds">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="IDs"
                                   ToolTip.Tip="All catalog identifiers for this object (Messier, NGC, IC, Caldwell, etc.)"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn Binding="{Binding TypeDisplay}"
                                    Width="150" SortMemberPath="TypeDisplay">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Type"
                                   ToolTip.Tip="Object type — Galaxy, Open Cluster, Globular Cluster, Planetary Nebula, etc."/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn Binding="{Binding Constellation}"
                                    Width="155" SortMemberPath="Constellation">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Constellation"
                                   ToolTip.Tip="Constellation the object is located in"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn Binding="{Binding MagnitudeDisplay}"
                                    Width="75" SortMemberPath="SortMag">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Mag"
                                   ToolTip.Tip="Apparent visual magnitude — lower numbers are brighter.&#x0a;&#x0a;Each step of 1 mag is ~2.5× in brightness:&#x0a;  Sun = −26 · Full Moon = −13 · Venus ≈ −4&#x0a;  Naked-eye limit (dark sky) ≈ 6.5&#x0a;  Binoculars ≈ 10 · Large amateur scope ≈ 14–15"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn Binding="{Binding SizeDisplay}"
                                    Width="95" SortMemberPath="SizeDisplay">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Size"
                                   ToolTip.Tip="Angular size on the sky. ' = arcminutes, &quot; = arcseconds.&#x0a;60' = 1° ≈ twice the width of the full Moon."/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn Binding="{Binding ScoreDisplay}"
                                    Width="90" SortMemberPath="SortScore">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Score"
                                   ToolTip.Tip="Observability score out of 100 for tonight.&#x0a;&#x0a;Weighted sum of:&#x0a;  Visibility fraction   15 pts&#x0a;  Absolute duration     10 pts  (full at ≥5 h)&#x0a;  Avg altitude          20 pts&#x0a;  Moon separation       20 pts&#x0a;  Brightness            15 pts&#x0a;  Angular size          10 pts&#x0a;  Peak altitude         10 pts"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <!-- Sky quality column (visible once Bortle class is known) -->
                <DataGridTemplateColumn Width="90" SortMemberPath="SortSkyQuality" CanUserSort="True">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="Sky"
                                   ToolTip.Tip="Sky quality for this object based on Bortle class and surface brightness.&#x0a;&#x0a;Excellent → object easily detected regardless of sky&#x0a;Good      → good sky improves detectability&#x0a;Fair      → requires decent dark sky&#x0a;Poor      → difficult from suburban skies&#x0a;Marginal  → needs near-perfect dark sky"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:ObjectRowViewModel">
                            <TextBlock Text="{Binding SkyQualityLabel}"
                                       Foreground="{Binding SkyQualityColor}"
                                       Margin="12,0" VerticalAlignment="Center"
                                       FontSize="11"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Binding="{Binding DurationDisplay}"
                                    Width="95" SortMemberPath="SortDuration">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Duration"
                                   ToolTip.Tip="How long the object is visible above your horizon during astronomical darkness tonight"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <!-- Vis. Start — template column so cells can carry a 12h tooltip -->
                <DataGridTemplateColumn Width="95" SortMemberPath="VisStartDisplay" CanUserSort="True">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="Vis. Start"
                                   ToolTip.Tip="When the object rises above your horizon (24h local time). Hover a cell for 12h format."/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:ObjectRowViewModel">
                            <TextBlock Text="{Binding VisStartDisplay}"
                                       ToolTip.Tip="{ReflectionBinding VisStart12h}"
                                       Margin="12,0" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Vis. End — template column so cells can carry a 12h tooltip -->
                <DataGridTemplateColumn Width="90" SortMemberPath="VisEndDisplay" CanUserSort="True">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="Vis. End"
                                   ToolTip.Tip="When the object sets below your horizon (24h local time). Hover a cell for 12h format."/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:ObjectRowViewModel">
                            <TextBlock Text="{Binding VisEndDisplay}"
                                       ToolTip.Tip="{ReflectionBinding VisEnd12h}"
                                       Margin="12,0" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Binding="{Binding PeakAltDisplay}"
                                    Width="90" SortMemberPath="SortPeakAlt">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Peak Alt"
                                   ToolTip.Tip="Highest altitude the object reaches during the night, followed by transit direction (N = peaks in northern sky, S = peaks in southern sky).&#x0a;Objects below ~20° suffer from atmospheric distortion and extinction."/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn Binding="{Binding PeakClearanceDisplay}"
                                    Width="95" SortMemberPath="SortClearance">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Peak Clr"
                                   ToolTip.Tip="Clearance above your custom horizon at peak altitude — headroom above local obstructions like trees or buildings.&#x0a;Same as Peak Alt when using a flat horizon."/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn Binding="{Binding MoonSepDisplay}"
                                    Width="105" SortMemberPath="SortMoonSep">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Moon Sep"
                                   ToolTip.Tip="Angular separation from the Moon at the object's peak altitude.&#x0a;Larger = less sky glow from the Moon. Below ~30° the Moon significantly washes out faint objects."/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <!-- Perihelion proximity (comets only, blank for other objects) -->
                <DataGridTemplateColumn Width="90" SortMemberPath="SortPerihelion" CanUserSort="True">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="Perihelion"
                                   ToolTip.Tip="Days to or from perihelion (nearest = brightest).&#x0a;&#x0a;Green  = within 60 days — near peak brightness&#x0a;Yellow = 60–180 days&#x0a;Gray   = &gt;180 days or not a comet"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:ObjectRowViewModel">
                            <TextBlock Text="{Binding PerihelionDisplay}"
                                       Foreground="{Binding PerihelionColor}"
                                       ToolTip.Tip="{Binding PerihelionTooltip}"
                                       Margin="12,0" VerticalAlignment="Center"
                                       FontSize="11"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Binding="{Binding BestSetupDisplay}"
                                    Width="200" SortMemberPath="SortBestFill">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Best Setup"
                                   ToolTip.Tip="Which of your imaging setups best matches this object's size, and the FOV it gives. Click the object for a full breakdown of all setups."/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</UserControl>
