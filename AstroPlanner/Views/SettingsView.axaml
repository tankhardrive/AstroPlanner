<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AstroPlanner.ViewModels"
             x:Class="AstroPlanner.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer>
        <StackPanel Spacing="20" Margin="24" MaxWidth="620">

            <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold"/>

            <!-- ── Observing Locations ── -->
            <Border BorderThickness="1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    CornerRadius="4"
                    Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Observing Locations" FontSize="15" FontWeight="SemiBold"/>

                    <!-- Location list -->
                    <ItemsControl ItemsSource="{Binding LocationRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LocationRowViewModel">
                                <Border Margin="0,2" Padding="8,6" CornerRadius="3"
                                        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                                    <Grid ColumnDefinitions="18,*,Auto,Auto,Auto,Auto">

                                        <!-- Active star -->
                                        <TextBlock Grid.Column="0" Text="★"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SystemAccentColorLight2}"
                                                   IsVisible="{Binding IsActive}"
                                                   VerticalAlignment="Center"/>

                                        <!-- Name + horizon summary -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="{Binding HorizonSummary}" FontSize="10" Opacity="0.55"/>
                                        </StackPanel>

                                        <!-- Edit -->
                                        <Button Grid.Column="2"
                                                Content="Edit"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).SelectLocationCommand}"
                                                CommandParameter="{Binding Location}"
                                                Margin="4,0,0,0" Padding="8,3" FontSize="12"/>

                                        <!-- Set Active (hidden when already active) -->
                                        <Button Grid.Column="3"
                                                Content="Set Active"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).SetActiveLocationCommand}"
                                                CommandParameter="{Binding Location}"
                                                IsVisible="{Binding !IsActive}"
                                                Margin="4,0,0,0" Padding="8,3" FontSize="12"/>

                                        <!-- Active label (shown in place of button when active) -->
                                        <TextBlock Grid.Column="3"
                                                   Text="Active"
                                                   FontSize="11" Opacity="0.6"
                                                   IsVisible="{Binding IsActive}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"/>

                                        <!-- Delete -->
                                        <Button Grid.Column="4"
                                                Content="✕"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).DeleteLocationCommand}"
                                                CommandParameter="{Binding Location}"
                                                Margin="4,0,0,0" Padding="6,3" FontSize="12"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="+ Add Location"
                            Command="{Binding AddLocationCommand}"
                            HorizontalAlignment="Left"
                            Padding="10,4"/>

                </StackPanel>
            </Border>

            <!-- ── Location editor (visible when a location is selected for editing) ── -->
            <Border BorderThickness="1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    CornerRadius="4"
                    Padding="16"
                    IsVisible="{Binding HasSelectedLocation}">
                <StackPanel Spacing="12">

                    <TextBlock Text="Edit Location" FontSize="15" FontWeight="SemiBold"/>

                    <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding LocName}"
                                   PlaceholderText="e.g. Home Backyard"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Latitude (°)" VerticalAlignment="Center"/>
                        <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding Latitude}"
                                   PlaceholderText="e.g. 28.5384  (positive = N)"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Longitude (°)" VerticalAlignment="Center"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding Longitude}"
                                   PlaceholderText="e.g. -81.3789  (negative = W)"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Elevation (m)" VerticalAlignment="Center"/>
                        <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding Elevation}"
                                   PlaceholderText="0"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Timezone (IANA)" VerticalAlignment="Center"/>
                        <TextBox   Grid.Row="4" Grid.Column="1" Text="{Binding TimeZoneId}"
                                   PlaceholderText="e.g. America/New_York"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Vis. step (min)" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Row="5" Grid.Column="1"
                                       Value="{Binding StepMinutes}"
                                       Minimum="1" Maximum="60" Increment="1"
                                       Width="115" HorizontalAlignment="Left"/>
                    </Grid>

                    <TextBlock Text="{Binding LocError}"
                               FontSize="12"
                               Foreground="{DynamicResource SystemAccentColorLight2}"
                               IsVisible="{Binding LocError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextWrapping="Wrap"/>

                    <Button Content="Save Location"
                            Command="{Binding SaveLocationCommand}"
                            HorizontalAlignment="Left"/>

                </StackPanel>
            </Border>

            <!-- ── Horizon editor (visible when a location is selected for editing) ── -->
            <Border BorderThickness="1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    CornerRadius="4"
                    Padding="16"
                    IsVisible="{Binding HasSelectedLocation}">
                <StackPanel Spacing="10">

                    <TextBlock Text="Horizon Profile" FontSize="15" FontWeight="SemiBold"/>

                    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                            CornerRadius="3" Padding="8,5">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Current:" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding HorizonSummary}"
                                       FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Button Content="Reset to Flat"
                                    Command="{Binding ClearHorizonCommand}"
                                    Padding="6,2" FontSize="11"
                                    Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Import from Stellarium format:" Opacity="0.7" FontSize="12"/>
                    <TextBlock FontSize="11" Opacity="0.5" TextWrapping="Wrap"
                               Text="Paste lines of: AZ ALT (space-separated degrees). Lines starting with # are ignored."/>

                    <TextBox Text="{Binding HorizonName}"
                             PlaceholderText="Profile name (optional)"/>

                    <TextBox Text="{Binding HorizonText}"
                             PlaceholderText="Paste horizon data here&#x0a;#AZ ALT&#x0a;0 21.9&#x0a;7 19.8&#x0a;..."
                             AcceptsReturn="True"
                             Height="120"
                             FontFamily="monospace"
                             FontSize="11"/>

                    <TextBlock Text="{Binding HorizonError}"
                               FontSize="12"
                               Foreground="{DynamicResource SystemAccentColorLight2}"
                               IsVisible="{Binding HorizonError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextWrapping="Wrap"/>

                    <Button Content="Import Horizon"
                            Command="{Binding ImportHorizonCommand}"
                            HorizontalAlignment="Left"/>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
