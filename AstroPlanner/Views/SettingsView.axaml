<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AstroPlanner.ViewModels"
             x:Class="AstroPlanner.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer>
        <StackPanel Spacing="20" Margin="24" MaxWidth="620">

            <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold"/>

            <!-- ── Observing Locations ── -->
            <Border BorderThickness="1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    CornerRadius="4"
                    Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Observing Locations" FontSize="15" FontWeight="SemiBold"/>

                    <!-- Location list -->
                    <ItemsControl ItemsSource="{Binding LocationRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LocationRowViewModel">
                                <Border Margin="0,2" Padding="8,6" CornerRadius="3"
                                        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                                    <Grid ColumnDefinitions="18,*,Auto,Auto,Auto,Auto">

                                        <!-- Active star -->
                                        <TextBlock Grid.Column="0" Text="★"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SystemAccentColorLight2}"
                                                   IsVisible="{Binding IsActive}"
                                                   VerticalAlignment="Center"/>

                                        <!-- Name + horizon summary -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="{Binding HorizonSummary}" FontSize="10" Opacity="0.55"/>
                                        </StackPanel>

                                        <!-- Edit -->
                                        <Button Grid.Column="2"
                                                Content="Edit"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).SelectLocationCommand}"
                                                CommandParameter="{Binding Location}"
                                                Margin="4,0,0,0" Padding="8,3" FontSize="12"/>

                                        <!-- Set Active (hidden when already active) -->
                                        <Button Grid.Column="3"
                                                Content="Set Active"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).SetActiveLocationCommand}"
                                                CommandParameter="{Binding Location}"
                                                IsVisible="{Binding !IsActive}"
                                                Margin="4,0,0,0" Padding="8,3" FontSize="12"/>

                                        <!-- Active label (shown in place of button when active) -->
                                        <TextBlock Grid.Column="3"
                                                   Text="Active"
                                                   FontSize="11" Opacity="0.6"
                                                   IsVisible="{Binding IsActive}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"/>

                                        <!-- Delete -->
                                        <Button Grid.Column="4"
                                                Content="✕"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).DeleteLocationCommand}"
                                                CommandParameter="{Binding Location}"
                                                Margin="4,0,0,0" Padding="6,3" FontSize="12"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="+ Add Location"
                            Command="{Binding AddLocationCommand}"
                            HorizontalAlignment="Left"
                            Padding="10,4"/>

                </StackPanel>
            </Border>

            <!-- ── Location editor (visible when a location is selected for editing) ── -->
            <Border BorderThickness="1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    CornerRadius="4"
                    Padding="16"
                    IsVisible="{Binding HasSelectedLocation}">
                <StackPanel Spacing="12">

                    <TextBlock Text="Edit Location" FontSize="15" FontWeight="SemiBold"/>

                    <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding LocName}"
                                   PlaceholderText="e.g. Home Backyard"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Latitude (°)" VerticalAlignment="Center"/>
                        <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding Latitude}"
                                   PlaceholderText="e.g. 28.5384  (positive = N)"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Longitude (°)" VerticalAlignment="Center"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding Longitude}"
                                   PlaceholderText="e.g. -81.3789  (negative = W)"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Elevation (m)" VerticalAlignment="Center"/>
                        <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding Elevation}"
                                   PlaceholderText="0"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Timezone (IANA)" VerticalAlignment="Center"/>
                        <TextBox   Grid.Row="4" Grid.Column="1" Text="{Binding TimeZoneId}"
                                   PlaceholderText="e.g. America/New_York"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Vis. step (min)" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Row="5" Grid.Column="1"
                                       Value="{Binding StepMinutes}"
                                       Minimum="1" Maximum="60" Increment="1"
                                       Width="115" HorizontalAlignment="Left"/>
                    </Grid>

                    <!-- Bortle class — separate from the grid so the label and input have plenty of room -->
                    <Border BorderThickness="1"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            CornerRadius="3"
                            Padding="10,8">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Bortle Class (1–9)"
                                       FontWeight="SemiBold" FontSize="13"
                                       ToolTip.Tip="Sky darkness scale: 1 = excellent dark sky, 9 = inner-city sky. Used to weight per-object detectability scores."/>
                            <TextBlock Text="1 = Excellent dark sky  ·  5 = Suburban  ·  9 = Inner-city"
                                       FontSize="11" Opacity="0.55"/>
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,0">
                                <NumericUpDown Value="{Binding BortleOverride}"
                                               Minimum="1" Maximum="9" Increment="1"
                                               FormatString="F0"
                                               Width="130"
                                               ToolTip.Tip="Leave blank — will be auto-fetched on the next Calculate"/>
                                <Button Content="Fetch from map API"
                                        Command="{Binding FetchBortleCommand}"
                                        Padding="10,4" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding BortleFetchMessage}"
                                       FontSize="12"
                                       Foreground="{DynamicResource SystemAccentColorLight2}"
                                       IsVisible="{Binding BortleFetchMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding LocError}"
                               FontSize="12"
                               Foreground="{DynamicResource SystemAccentColorLight2}"
                               IsVisible="{Binding LocError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextWrapping="Wrap"/>

                    <Button Content="Save Location"
                            Command="{Binding SaveLocationCommand}"
                            HorizontalAlignment="Left"/>

                </StackPanel>
            </Border>

            <!-- ── Horizon editor (visible when a location is selected for editing) ── -->
            <Border BorderThickness="1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    CornerRadius="4"
                    Padding="16"
                    IsVisible="{Binding HasSelectedLocation}">
                <StackPanel Spacing="10">

                    <TextBlock Text="Horizon Profile" FontSize="15" FontWeight="SemiBold"/>

                    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                            CornerRadius="3" Padding="8,5">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Current:" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding HorizonSummary}"
                                       FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Button Content="Reset to Flat"
                                    Command="{Binding ClearHorizonCommand}"
                                    Padding="6,2" FontSize="11"
                                    Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Import from Stellarium format:" Opacity="0.7" FontSize="12"/>
                    <TextBlock FontSize="11" Opacity="0.5" TextWrapping="Wrap"
                               Text="Paste lines of: AZ ALT (space-separated degrees). Lines starting with # are ignored."/>

                    <TextBox Text="{Binding HorizonName}"
                             PlaceholderText="Profile name (optional)"/>

                    <TextBox Text="{Binding HorizonText}"
                             PlaceholderText="Paste horizon data here&#x0a;#AZ ALT&#x0a;0 21.9&#x0a;7 19.8&#x0a;..."
                             AcceptsReturn="True"
                             Height="120"
                             FontFamily="monospace"
                             FontSize="11"/>

                    <TextBlock Text="{Binding HorizonError}"
                               FontSize="12"
                               Foreground="{DynamicResource SystemAccentColorLight2}"
                               IsVisible="{Binding HorizonError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextWrapping="Wrap"/>

                    <Button Content="Import Horizon"
                            Command="{Binding ImportHorizonCommand}"
                            HorizontalAlignment="Left"/>

                </StackPanel>
            </Border>

            <!-- ── Imaging Setups list ── -->
            <Border BorderThickness="1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    CornerRadius="4"
                    Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Imaging Setups" FontSize="15" FontWeight="SemiBold"/>

                    <ItemsControl ItemsSource="{Binding SetupRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ImagingSetupViewModel">
                                <Border Margin="0,2" Padding="8,6" CornerRadius="3"
                                        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="{Binding FovDisplay}" FontSize="10" Opacity="0.55"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="Edit"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).SelectSetupCommand}"
                                                CommandParameter="{Binding $self.DataContext}"
                                                Margin="4,0,0,0" Padding="8,3" FontSize="12"/>
                                        <Button Grid.Column="2"
                                                Content="✕"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).DeleteSetupCommand}"
                                                CommandParameter="{Binding Source}"
                                                Margin="4,0,0,0" Padding="6,3" FontSize="12"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="+ Add Setup"
                            Command="{Binding AddSetupCommand}"
                            HorizontalAlignment="Left"
                            Padding="10,4"/>
                </StackPanel>
            </Border>

            <!-- ── Setup editor ── -->
            <Border BorderThickness="1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    CornerRadius="4"
                    Padding="16"
                    IsVisible="{Binding HasSelectedSetup}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Edit Setup" FontSize="15" FontWeight="SemiBold"/>

                    <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Setup Name" VerticalAlignment="Center"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding SelectedSetup.Name}"
                                   PlaceholderText="e.g. RC8 + ASI2600"/>

                        <Separator Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Telescope" VerticalAlignment="Center" Opacity="0.7" FontSize="12"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding SelectedSetup.TelescopeName}"
                                   PlaceholderText="e.g. Celestron RC8" FontSize="12"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Aperture (mm)" VerticalAlignment="Center" FontSize="12"/>
                        <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding SelectedSetup.ApertureMm}"
                                   PlaceholderText="e.g. 203" FontSize="12"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Focal Length (mm)" VerticalAlignment="Center" FontSize="12"/>
                        <TextBox   Grid.Row="4" Grid.Column="1" Text="{Binding SelectedSetup.FocalLengthMm}"
                                   PlaceholderText="e.g. 1624" FontSize="12"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="f/ratio" VerticalAlignment="Center"
                                   FontSize="12" Opacity="0.6"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedSetup.FRatioDisplay}"
                                   FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>

                        <Separator Grid.Row="6" Grid.ColumnSpan="2" Margin="0,4"/>

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Camera" VerticalAlignment="Center" Opacity="0.7" FontSize="12"/>
                        <TextBox   Grid.Row="7" Grid.Column="1" Text="{Binding SelectedSetup.CameraName}"
                                   PlaceholderText="e.g. ZWO ASI2600MC-Pro" FontSize="12"/>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Pixel Size (µm)" VerticalAlignment="Center" FontSize="12"/>
                        <TextBox   Grid.Row="8" Grid.Column="1" Text="{Binding SelectedSetup.PixelSizeMicrons}"
                                   PlaceholderText="e.g. 3.76" FontSize="12"/>

                        <TextBlock Grid.Row="9" Grid.Column="0" Text="Sensor (px W×H)" VerticalAlignment="Center" FontSize="12"/>
                        <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <TextBox Text="{Binding SelectedSetup.SensorWidthPixels}"
                                     PlaceholderText="6248" Width="80" FontSize="12"/>
                            <TextBlock Text="×" VerticalAlignment="Center" Opacity="0.6"/>
                            <TextBox Text="{Binding SelectedSetup.SensorHeightPixels}"
                                     PlaceholderText="4176" Width="80" FontSize="12"/>
                        </StackPanel>

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Plate scale / FOV" VerticalAlignment="Center"
                                   FontSize="12" Opacity="0.6"/>
                        <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedSetup.PlateScaleDisplay}"
                                       FontSize="12" Opacity="0.6"/>
                            <TextBlock Text="{Binding SelectedSetup.FovDisplay}"
                                       FontSize="12" Opacity="0.6"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding SetupError}"
                               FontSize="12"
                               Foreground="{DynamicResource SystemAccentColorLight2}"
                               IsVisible="{Binding SetupError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextWrapping="Wrap"/>

                    <Button Content="Save Setup"
                            Command="{Binding SaveSetupCommand}"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- ── Weather Thresholds ── -->
            <Border BorderThickness="1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    CornerRadius="4"
                    Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Weather Thresholds" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                               Text="Hours that exceed any threshold are highlighted red in the weather detail view. The strip gradient uses absolute scores independent of these values."/>

                    <Grid ColumnDefinitions="260,*,60" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Max Cloud Cover" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Row="0" Grid.Column="1"
                                       Value="{Binding MaxCloudCover}"
                                       Minimum="0" Maximum="100" Increment="5"
                                       Width="115" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="%" VerticalAlignment="Center" Opacity="0.6"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Max Wind Speed" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Row="1" Grid.Column="1"
                                       Value="{Binding MaxWindSpeed}"
                                       Minimum="0" Maximum="200" Increment="5"
                                       Width="115" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="mph" VerticalAlignment="Center" Opacity="0.6"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Min Wind Chill" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Row="2" Grid.Column="1"
                                       Value="{Binding MinWindChill}"
                                       Minimum="-100" Maximum="130" Increment="5"
                                       Width="115" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="°F" VerticalAlignment="Center" Opacity="0.6"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Max Humidity" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Row="3" Grid.Column="1"
                                       Value="{Binding MaxHumidity}"
                                       Minimum="0" Maximum="100" Increment="5"
                                       Width="115" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="%" VerticalAlignment="Center" Opacity="0.6"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Max Precip Probability" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Row="4" Grid.Column="1"
                                       Value="{Binding MaxPrecipProbability}"
                                       Minimum="0" Maximum="100" Increment="5"
                                       Width="115" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="%" VerticalAlignment="Center" Opacity="0.6"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Min Visibility" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Row="5" Grid.Column="1"
                                       Value="{Binding MinVisibility}"
                                       Minimum="0" Maximum="100" Increment="1"
                                       Width="115" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Row="5" Grid.Column="2" Text="mi" VerticalAlignment="Center" Opacity="0.6"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Max Seeing  (1=best, 8=worst)" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <NumericUpDown Grid.Row="6" Grid.Column="1"
                                       Value="{Binding MaxSeeing}"
                                       Minimum="1" Maximum="8" Increment="1"
                                       Width="115" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Row="6" Grid.Column="2" Text="1–8" VerticalAlignment="Center" Opacity="0.6"/>

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Min Transparency  (1=worst, 8=best)" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <NumericUpDown Grid.Row="7" Grid.Column="1"
                                       Value="{Binding MinTransparency}"
                                       Minimum="1" Maximum="8" Increment="1"
                                       Width="115" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Row="7" Grid.Column="2" Text="1–8" VerticalAlignment="Center" Opacity="0.6"/>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Max Moon Illumination" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Row="8" Grid.Column="1"
                                       Value="{Binding MaxMoonIllumination}"
                                       Minimum="0" Maximum="100" Increment="5"
                                       Width="115" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Row="8" Grid.Column="2" Text="%" VerticalAlignment="Center" Opacity="0.6"/>

                    </Grid>

                    <TextBlock Text="{Binding WeatherSaveMessage}"
                               FontSize="12"
                               Foreground="{DynamicResource SystemAccentColorLight2}"
                               IsVisible="{Binding WeatherSaveMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextWrapping="Wrap"/>

                    <Button Content="Save Weather Settings"
                            Command="{Binding SaveWeatherThresholdsCommand}"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
