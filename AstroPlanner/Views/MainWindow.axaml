<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AstroPlanner.ViewModels"
        xmlns:views="using:AstroPlanner.Views"
        xmlns:controls="using:AstroPlanner.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="850"
        x:Class="AstroPlanner.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/astroplanner.ico"
        Title="AstroPlanner"
        MinWidth="900" MinHeight="600"
        Width="1400" Height="850">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel>

        <!-- ── Top toolbar ── -->
        <Border DockPanel.Dock="Top"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                Padding="12,6">
            <Grid ColumnDefinitions="Auto,16,Auto,16,*,16,Auto,8,Auto,16,Auto">

                <TextBlock Grid.Column="0"
                           Text="AstroPlanner"
                           FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <!-- Observing date -->
                <CalendarDatePicker Grid.Column="2"
                                    SelectedDate="{Binding ObservingDate}"
                                    VerticalAlignment="Center"
                                    Width="150"
                                    ToolTip.Tip="Observing date"/>

                <!-- Site + horizon + moon + Bortle info -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SiteName}" VerticalAlignment="Center"/>
                    <TextBlock Text="•" VerticalAlignment="Center" Opacity="0.4"/>
                    <TextBlock Text="{Binding HorizonName}" VerticalAlignment="Center" Opacity="0.7"/>
                    <TextBlock Text="•" VerticalAlignment="Center" Opacity="0.4"/>
                    <TextBlock Text="{Binding MoonInfo}" VerticalAlignment="Center" Opacity="0.8"/>

                    <!-- Bortle badge — only shown once fetched -->
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                IsVisible="{Binding BortleDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="•" VerticalAlignment="Center" Opacity="0.4"/>
                        <Button Content="{Binding BortleDisplay}"
                                Command="{Binding OpenLightPollutionMapCommand}"
                                ToolTip.Tip="{Binding BortleToolTip}"
                                Foreground="{Binding BortleColor}"
                                VerticalAlignment="Center"
                                Padding="4,2"
                                FontSize="12"
                                FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <!-- Calculate button -->
                <Button Grid.Column="6"
                        Content="⟳  Calculate"
                        Command="{Binding CalculateCommand}"
                        IsEnabled="{Binding Planner.IsNotCalculating}"
                        Classes="accent"
                        VerticalAlignment="Center"/>

                <!-- Progress bar (calculating) -->
                <ProgressBar Grid.Column="8"
                             Value="{Binding Planner.CalculationProgress}"
                             Maximum="100"
                             Width="120" Height="6"
                             IsVisible="{Binding Planner.IsCalculating}"
                             VerticalAlignment="Center"/>

                <!-- Settings toggle -->
                <Button Grid.Column="10"
                        Content="⚙ Settings"
                        Command="{Binding ToggleSettingsCommand}"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ── Weather strip ── -->
        <controls:WeatherStripControl
            DockPanel.Dock="Bottom"
            Height="50"
            Hours="{Binding WeatherStrip.Hours}"
            DarkStart="{Binding WeatherStrip.DarkStart}"
            DarkEnd="{Binding WeatherStrip.DarkEnd}"
            TimeZone="{Binding WeatherStrip.TimeZone}"
            IsLoading="{Binding WeatherStrip.IsLoading}"
            HasData="{Binding WeatherStrip.HasData}"
            StatusMessage="{Binding WeatherStrip.StatusMessage}"
            Command="{Binding OpenWeatherDetailCommand}"
            Cursor="Hand"/>

        <!-- ── Main content area ── -->
        <Grid>

            <!-- Tab control (hidden while settings open) -->
            <TabControl SelectedIndex="{Binding ActiveTabIndex}"
                        IsVisible="{Binding IsNotShowSettings}">

                <!-- Tab 1: Planner -->
                <TabItem Header="Planner">
                    <Grid ColumnDefinitions="*,Auto">

                        <!-- Object list (PlannerView DataContext set in code-behind) -->
                        <views:PlannerView Grid.Column="0" x:Name="PlannerViewControl"/>

                        <!-- Detail panel (shown when an object is selected) -->
                        <Border Grid.Column="1"
                                Width="360"
                                IsVisible="{Binding Detail.IsVisible}"
                                BorderThickness="1,0,0,0"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
                            <!-- ObjectDetailView DataContext set in code-behind -->
                            <views:ObjectDetailView x:Name="DetailViewControl"/>
                        </Border>

                    </Grid>
                </TabItem>

                <!-- Tab 2: Year planner -->
                <TabItem Header="Year">
                    <views:YearPlannerView x:Name="YearPlannerViewControl"/>
                </TabItem>

            </TabControl>

            <!-- Settings panel — wrapper owns IsVisible so the DataContext swap on SettingsView
                 doesn't break the binding (DataContext set in code-behind on inner view only) -->
            <Border IsVisible="{Binding ShowSettings}">
                <views:SettingsView x:Name="SettingsViewControl"/>
            </Border>

        </Grid>
    </DockPanel>
</Window>
